# Margin — environment configuration.
# Copy to .env.local for local development (Next.js loads .env.local automatically).

# Optional for the MVP. When set, /api/diagnose and /api/practice call Claude
# for real rubric-calibrated scoring + faded-worked-example generation.
# When UNSET, the app runs entirely on a deterministic mock engine so the full
# UX (studio → diagnose → practise → revise → prove) works with no key.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for the evaluator/scorer + feedback engine. Defaults to a sensible
# current Claude model if unset.
MARGIN_MODEL=claude-sonnet-4-6

# Optional — Google sign-in (OAuth2). When BOTH are set, the "Continue with
# Google" button on /signin is enabled. Add this app's
# `${origin}/api/auth/google/callback` as an authorised redirect URI in the
# Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — where the server JSON store is written (defaults to ./data).
MARGIN_DATA_DIR=
