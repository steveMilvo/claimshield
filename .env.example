# Founder Tax Blueprint environment configuration.
# Copy to .env.local for local development (Next.js loads .env.local automatically).

# Required — Claude API key for report generation.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required for monetisation — Stripe secret key.
# Get test/live keys at https://dashboard.stripe.com/apikeys
# Use sk_test_... while developing; switch to sk_live_... in production.
STRIPE_SECRET_KEY=

# Optional — price for the full Blueprint in AUD cents (default 9900 = $99 AUD).
STRIPE_PRICE_AUD_CENTS=9900

# Optional — public app URL for Stripe success/cancel redirects.
# Leave blank to auto-detect from the request. Set explicitly in production.
NEXT_PUBLIC_APP_URL=
