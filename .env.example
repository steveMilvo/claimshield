# Copy to .env.local and set your key to enable Claude generation in the
# Teacher Content Studio. Without it, the Studio falls back to the offline
# rule-based generator (still fully usable).
ANTHROPIC_API_KEY=

# Optional model overrides (defaults shown):
# PIP_GEN_MODEL=claude-sonnet-4-6
# PIP_VERIFY_MODEL=claude-sonnet-4-6
