# ClaimShield environment configuration.
# Copy to .env.local for local development (Next.js loads .env.local automatically).

# Required for the /api/analyze route (policy parsing + claim analysis via Claude).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional — LegisPro document-generation engine (SynthexIQ ecosystem).
# When BOTH are set, /api/document generates the appeal / demand / complaint
# via LegisPro; otherwise it falls back to a built-in .docx generator.
# See src/lib/legispro.ts for the (currently assumed) request/response contract.
LEGISPRO_BASE_URL=
LEGISPRO_API_KEY=
